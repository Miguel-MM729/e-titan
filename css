* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f4f4;
    color: #333;
}

header {
    background: #111;
    color: white;
    padding: 20px;
    text-align: center;
}

nav a {
    color: white;
    margin: 0 15px;
    text-decoration: none;
}

.hero {
    padding: 80px 20px;
    text-align: center;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
}

section {
    padding: 60px 20px;
    text-align: center;
}

button {
    padding: 10px 20px;
    border: none;
    background: #333;
    color: white;
    cursor: pointer;
    margin-top: 10px;
}

button:hover {
    background: #555;
}

form input, form textarea {
    width: 80%;
    padding: 10px;
    margin: 10px 0;
}

footer {
    background: #111;
    color: white;
    padding: 20px;
    text-align: center;
}
